# ── Local development ──────────────────────────────────────────────
# Use your local Postgres credentials
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# ── Production / Neon ──────────────────────────────────────────────
# Get from neon.tech → your project → Connect → Connection string
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

JWT_SECRET=your-strong-secret-here-change-this
PORT=3001
NODE_ENV=development
